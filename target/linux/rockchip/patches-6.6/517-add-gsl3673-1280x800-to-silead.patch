+static int prep_raw_size_conv_data(struct silead_ts_data *data)
+{
+	int i, k;
+	u16 *cod;
+	u32 ts_max_k, raw_max_k;
+	u32 conv_arr_k_len;
+
+	cod = data->raw_size_conv_x;
+	ts_max_k = data->ts_size_x;
+	raw_max_k = data->raw_size_x;
+	conv_arr_k_len = ARRAY_SIZE(data->raw_size_conv_x);
+
+	for (k = 0; k < 2; k++) {
+		if (raw_max_k == 0 || raw_max_k >= conv_arr_k_len) {
+			dev_err(&data->client->dev, "Incorrect raw-size-%c value: %u !",
+				(k == 0 ? 'x' : 'y'), raw_max_k);
+			return -EINVAL;
+		}
+
+		for (i = 0; i < raw_max_k; i++) {
+			cod[i] = DIV_ROUND_CLOSEST(i * ts_max_k, raw_max_k);
+		}
+
+		cod = data->raw_size_conv_y;
+		ts_max_k = data->ts_size_y;
+		raw_max_k = data->raw_size_y;
+		conv_arr_k_len = ARRAY_SIZE(data->raw_size_conv_y);
+	}
+
+	return 0;
+}
