+static u16 raw_size_to_ts(struct silead_ts_data *data, u16 val, char axis)
+{
+	u16 *cod;
+	u32 raw_max_k;
+
+	if (axis == 'x') {
+		cod = data->raw_size_conv_x;
+		raw_max_k = data->raw_size_x;
+	} else {
+		cod = data->raw_size_conv_y;
+		raw_max_k = data->raw_size_y;
+	}
+
+	if (val >= raw_max_k) {
+		val = raw_max_k - 1;
+	}
+
+	return cod[val];
+}
