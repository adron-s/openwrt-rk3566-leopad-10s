+static void SortBubble(int t[],int size)
+{
+	int temp = 0;
+	int m,n;
+	for(m=0;m<size;m++)
+	{
+		for(n=m+1;n<size;n++)
+		{
+			temp = t[m];
+			if (temp>t[n])
+			{
+				t[m] = t[n];
+				t[n] = temp;
+			}
+		}
+	}
+}
+int abs(int i){
+ 	if(i<0)
+		return ~(--i);
+	return i;
+}
+static int Sqrt(int d)
+{
+	int ret = 0;
+	int i;
+	for(i=14;i>=0;i--)
+	{
+		if((ret + (0x1<<i))*(ret + (0x1<<i)) <= d)
+			ret |= (0x1<<i);
+	}
+	return ret;
+}
