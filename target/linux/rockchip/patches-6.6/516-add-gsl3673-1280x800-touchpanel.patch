+static void gsl_download_fw_work(struct work_struct *work)
+{
+	struct gsl_ts *ts = container_of(work, struct gsl_ts, download_fw_work);
+
+	clr_reg(ts->client);
+	reset_chip(ts->client);
+	gsl_load_fw(ts->client);
+	startup_chip(ts->client);
+	reset_chip(ts->client);
+	startup_chip(ts->client);
+}
