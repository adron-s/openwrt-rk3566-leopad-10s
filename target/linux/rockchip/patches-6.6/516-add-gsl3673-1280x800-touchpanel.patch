+static int ConfigCoorMulti(int data[])
+{
+	int i,j;
+	int n = 0;
+	for(i=0;i<4;i++)
+	{
+		if(data[247+i]!=0)
+		{
+			if((data[247+i]&63)==0 && (data[247+i]>>16)<4)
+				n++;
+			else
+				return FALSE;
+		}
+		if(data[251+i]!=0)
+		{
+			if((data[251+i]&63)==0 && (data[251+i]>>16)<4)
+				n++;
+			else
+				return FALSE;
+		}
+	}
+	if(n == 0 || n > 4)
+		return FALSE;
+	for(j=0;j<n;j++)
+	{
+		for(i=0;i<64;i++)
+		{
+			if(data[256+j*64+i] >= 64)
+				return FALSE;
+			if(i)
+			{
+				if(data[256+j*64+i] < data[256+j*64+i-1])
+					return FALSE;
+			}
+		}
+	}
+	return TRUE;
+}
