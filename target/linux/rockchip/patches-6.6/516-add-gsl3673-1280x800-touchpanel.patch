+		if(ignore_x[i] & 0x8000)
+			ignore_x[i] |= 0xffff0000;
+		if(ignore_y[i] & 0x8000)
+			ignore_y[i] |= 0xffff0000;
+	}
+	for(i=0;i<CONFIG_LENGTH;i++)
+		config_static[i] = 0;
+}
