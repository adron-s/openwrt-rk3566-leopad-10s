+static void gsl_io_control(struct i2c_client *client)
+{
+#ifdef GSL9XX_VDDIO_1800
+	u8 buf[4] = {0};
+	int i;
+
+	for (i = 0; i < 5; i++) {
+		buf[0] = 0;
+		buf[1] = 0;
+		buf[2] = 0xfe;
+		buf[3] = 0x1;
+		gsl_ts_write(client, 0xf0, buf, 4);
+		buf[0] = 0x5;
+		buf[1] = 0;
+		buf[2] = 0;
+		buf[3] = 0x80;
+		gsl_ts_write(client, 0x78, buf, 4);
+		usleep_range(5*1000, 5*1100);
+	}
+	usleep_range(50*1000, 50*1100);
+#endif
+}
