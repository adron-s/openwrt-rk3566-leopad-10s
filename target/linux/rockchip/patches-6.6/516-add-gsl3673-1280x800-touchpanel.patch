+void gsl_ReportPressure(unsigned int *p)
+{
+	int i;
+	for(i=0;i<POINT_MAX;i++)
+	{
+		if(i < point_num)
+		{
+			if(pressure_now[i] == 0)
+				p[i] = 0;
+			else if(pressure_now[i] <= 7)
+				p[i] = 1;
+			else if(pressure_now[i] > 63+7)
+				p[i] = 63;
+			else
+				p[i] = pressure_now[i] - 7;
+		}
+		else
+			p[i] = 0;
+	}
+}
