+static int gsl3673_init(void)
+{
+	struct device *dev = &this_ts->client->dev;
+
+	this_ts->irq_gpio = devm_gpiod_get(dev, "irq", GPIOD_IN);
+	if (IS_ERR(this_ts->irq_gpio)) {
+		dev_err(dev, "Failed to get IRQ GPIO\n");
+		return PTR_ERR(this_ts->irq_gpio);
+	}
+	this_ts->rst_gpio = devm_gpiod_get(dev, "rst", GPIOD_OUT_LOW);
+	if (IS_ERR(this_ts->rst_gpio)) {
+		dev_err(dev, "Failed to get reset GPIO\n");
+		return PTR_ERR(this_ts->rst_gpio);
+	}
+
+  gpiod_set_value(this_ts->rst_gpio, 1);
+	return 0;
+}
