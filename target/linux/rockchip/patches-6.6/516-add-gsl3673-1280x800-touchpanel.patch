+static irqreturn_t gsl_ts_irq(int irq, void *dev_id)
+{
+	struct gsl_ts *ts = (struct gsl_ts *)dev_id;
+
+	ts_irq_disable(ts);
+	if (!work_pending(&ts->work))
+		queue_work(ts->wq, &ts->work);
+	return IRQ_HANDLED;
+}
