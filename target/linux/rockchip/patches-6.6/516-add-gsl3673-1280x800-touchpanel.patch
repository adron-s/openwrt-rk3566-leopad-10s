+static unsigned int CCO(unsigned int x,unsigned int coe[],int k)
+{
+	if(k == 0)
+	{
+		if(x & 32)
+			return (x & ~31)+(31 - (coe[31-(x&31)] & 31));
+		else
+			return (x & ~31)+(coe[x&31] & 31);
+	}
+	if(k == 1)
+	{
+		if(x & 64)
+			return (x & ~63)+(63 - (coe[63-(x&63)] & 63));
+		else
+			return (x & ~63)+(coe[x&63] & 63);
+	}
+	if(k == 2)
+	{
+		return (x & ~63)+(coe[x&63] & 63);
+	}
+	return 0;
+}
