+static int ConfigKeyMap(int data[])
+{
+	int i;
+	if(data[217] != 1)
+		return FALSE;
+	for(i=0;i<8;i++)
+	{
+		if(data[218+2] == 0)
+			return FALSE;
+		if((data[218+i*3+0]>>16) > (data[218+i*3+0]&0xffff))
+			return FALSE;
+		if((data[218+i*3+1]>>16) > (data[218+i*3+1]&0xffff))
+			return FALSE;
+	}
+	return TRUE;
+}
