+static int ConfigFilter(unsigned int data[])
+{
+	int i;
+	unsigned int ps_c[8];
+	unsigned int pr_c[8];
+	unsigned int sum = 0;
+	//if(data[242]>1 && (data[255]>=0 && data[255]<=256))
+	if (data[242]>1 && (data[255] <= 256))
+	{
+		for(i=0;i<8;i++)
+		{
+			ps_c[i] = (data[243+i/4] >> ((i%4)*8)) & 0xff;
+			pr_c[i] = (data[243+i/4+2] >> ((i%4)*8)) & 0xff;
+			if(ps_c[i] >= 0x80)
+				ps_c[i] |= 0xffffff00;
+			if(pr_c[i] >= 0x80)
+				pr_c[i] |= 0xffffff00;
+			sum += ps_c[i];
+			sum += pr_c[i];
+		}
+		if(sum == data[242] || sum + data[242] == 0)
+			return TRUE;
+	}
+	return FALSE;
+}
