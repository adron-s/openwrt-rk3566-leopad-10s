+static int gsl_ts_early_suspend(struct tp_device *tp_d)
+{
+	struct gsl_ts *ts = container_of(tp_d, struct gsl_ts, tp);
+
+	gsl_ts_suspend(&ts->client->dev);
+	return 0;
+}
