config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/unisoc_wifi'
	option band '5g'
	option channel '36'
	option htmode 'VHT80'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'wifi'
	option mode 'sta'
	option ssid 'adron_home_ZTE_5G'
	option encryption 'psk-mixed'
	option key '1234554321'
