/dts-v1/;

/memreserve/	0x00007a32a4800000 0x0000000000000600;
/ {
	totalsize = <0x16c1200>;
	timestamp = <0x68282fa9>;
	version = <0x00>;
	description = "U-Boot FIT source file for arm";
	#address-cells = <0x01>;

	images {

		fdt {
			data-size = <0xdac5>;
			data-position = <0x800>;
			type = "flat_dt";
			arch = "arm64";
