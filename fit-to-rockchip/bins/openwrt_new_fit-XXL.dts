			load = <0xffffff00>;

			hash {
				value = <0xb5708309 0xbcd92e73 0x25683731 0xc90778e8 0x7e38b61a 0x15976af3 0x5532abbd 0x231cdb6a>;
				algo = "sha256";
			};
		};

		kernel {
			data-size = <0x16a4808>;
			data-position = <0xe400>;
			type = "kernel";
			arch = "arm64";
			os = "linux";
			compression = "none";
			entry = <0x3200000>;
			load = <0x3200000>;

			hash {
				value = <0x3f53a72 0xd0008e64 0xb2c8fba5 0xa6e407b9 0xe7f36809 0x7259402e 0xd25d5b91 0xffadf455>;
				algo = "sha256";
			};
		};

		resource {
			data-size = <0xe000>;
			data-position = <0x16b2e00>;
			type = "multi";
			arch = "arm64";
